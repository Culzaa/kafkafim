<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.2</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>io.github.matabar</groupId>
	<artifactId>kafkafim</artifactId>
	<version>${revision}</version>
	<name>kafkafim</name>
	<description>Production-grade Kafka to Elasticsearch ingest service</description>
	<url>https://github.com/matabar/kafkafim</url>
	<licenses>
		<license>
			<name>MIT License</name>
			<url>https://opensource.org/license/mit</url>
		</license>
	</licenses>
	<scm>
		<connection>scm:git:https://github.com/matabar/kafkafim.git</connection>
		<developerConnection>scm:git:git@github.com:matabar/kafkafim.git</developerConnection>
		<url>https://github.com/matabar/kafkafim</url>
	</scm>
	<properties>
		<java.version>27</java.version>
		<!-- CI-friendly version: releases pass -Drevision=<git tag> (docs/DELIVERY.md) -->
		<revision>0.1.0-SNAPSHOT</revision>
		<!-- Libraries not managed by the Spring Boot BOM -->
		<resilience4j.version>2.4.0</resilience4j.version>
		<archunit.version>1.5.1</archunit.version>
		<!-- Not in the Boot, OpenTelemetry or Micrometer BOMs: keep equal to the version
		     micrometer-registry-otlp ${micrometer.version} depends on (runtime scope).
		     The maven-enforcer-plugin execution below fails the build when they differ. -->
		<opentelemetry-proto.version>1.10.0-alpha</opentelemetry-proto.version>
		<!-- OpenTelemetry instrumentation release for the Logback log bridge (ADR-0044) and the
		     Kafka client instrumentation. Not in the Boot or OpenTelemetry BOMs: keep on the
		     instrumentation release built against the BOM's ${opentelemetry.version}
		     (instrumentation 2.N pairs with SDK 1.(N+34)). Dependabot ignores both artifacts
		     (.github/dependabot.yml); bump it in the Boot upgrade that moves the SDK. -->
		<opentelemetry-logback-appender.version>2.28.1-alpha</opentelemetry-logback-appender.version>
		<!-- Google Java Style (ADR-0024) -->
		<spotless.version>3.11.0</spotless.version>
		<google-java-format.version>2.0.0</google-java-format.version>
		<checkstyle.version>14.4.0</checkstyle.version>
		<maven-checkstyle-plugin.version>3.6.0</maven-checkstyle-plugin.version>
		<!-- Parallel Failsafe JVMs for the *IntegrationTest classes; override with -Dit.forkCount=N -->
		<it.forkCount>3</it.forkCount>
		<!-- Coverage (docs/DELIVERY.md, "Coverage floor") -->
		<jacoco.version>0.8.16</jacoco.version>
		<!-- true skips only the floor check (CI's partial jobs); jacoco.skip would also stop data collection -->
		<jacoco.check.skip>false</jacoco.check.skip>
		<!-- Mutation testing of route and decode (docs/DELIVERY.md, "Mutation testing") -->
		<pitest.version>1.30.2</pitest.version>
		<pitest-junit5.version>1.2.3</pitest-junit5.version>
		<!-- Measured 2026-11-17: 95.7 % of 511 mutants killed (489), identical in two runs of about 30 s.
		     The floor sits just below; raise it when the score rises. -->
		<pitest.mutation.threshold>95</pitest.mutation.threshold>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-kafka</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-opentelemetry</artifactId>
		</dependency>
		<dependency>
			<!-- Feeds Logback events to the OpenTelemetry SDK's logger provider, which Spring Boot
			     auto-configures with an OTLP exporter (logback-spring.xml, ADR-0044). -->
			<groupId>io.opentelemetry.instrumentation</groupId>
			<artifactId>opentelemetry-logback-appender-1.0</artifactId>
			<version>${opentelemetry-logback-appender.version}</version>
		</dependency>
		<dependency>
			<!-- Kafka client spans and metrics (ADR-0013). The only tracing mechanism for the Kafka
			     clients: no OpenTelemetry Java agent, no Spring Kafka observation. -->
			<groupId>io.opentelemetry.instrumentation</groupId>
			<artifactId>opentelemetry-kafka-clients-2.6</artifactId>
			<version>${opentelemetry-logback-appender.version}</version>
		</dependency>
		<dependency>
			<!-- Brings KafkaProcessRequest, the type of the one hook the library offers to see a
			     consumer process span (ProcessSpanContexts); the artifact above only
			     pulls it in at runtime. Same release, same property. -->
			<groupId>io.opentelemetry.instrumentation</groupId>
			<artifactId>opentelemetry-kafka-clients-common-0.11</artifactId>
			<version>${opentelemetry-logback-appender.version}</version>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>

		<!-- Elasticsearch: low-level REST client only (plain HTTP, version-agnostic; we build bulk bodies ourselves).
		     The rest5 variant (Apache HttpClient 5) is the one managed by the Spring Boot 4 BOM. -->
		<dependency>
			<groupId>co.elastic.clients</groupId>
			<artifactId>elasticsearch-rest5-client</artifactId>
		</dependency>
		<!-- Circuit breaker per Elasticsearch cluster (bulk retry is the sink's own loop, ADR-0026) -->
		<dependency>
			<groupId>io.github.resilience4j</groupId>
			<artifactId>resilience4j-circuitbreaker</artifactId>
			<version>${resilience4j.version}</version>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-docker-compose</artifactId>
			<scope>runtime</scope>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-registry-prometheus</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-kafka-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-opentelemetry-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-testcontainers</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<!-- Runtime, not test: a direct test-scoped declaration would win over the
			     transitive runtime scope and drop the jar micrometer-registry-otlp needs.
			     Declared so OtlpExportIntegrationTest, which decodes the captured OTLP
			     request bodies with it, does not rely on a transitive dependency. -->
			<groupId>io.opentelemetry.proto</groupId>
			<artifactId>opentelemetry-proto</artifactId>
			<version>${opentelemetry-proto.version}</version>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-grafana</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-kafka</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-elasticsearch</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.awaitility</groupId>
			<artifactId>awaitility</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- Package-boundary rules (ADR-0003) -->
		<dependency>
			<groupId>com.tngtech.archunit</groupId>
			<artifactId>archunit-junit5</artifactId>
			<version>${archunit.version}</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<!-- Formatting: google-java-format. `./mvnw spotless:apply` fixes; `check` fails the build in validate. -->
				<groupId>com.diffplug.spotless</groupId>
				<artifactId>spotless-maven-plugin</artifactId>
				<version>${spotless.version}</version>
				<configuration>
					<java>
						<includes>
							<include>src/main/java/**/*.java</include>
							<include>src/test/java/**/*.java</include>
						</includes>
						<googleJavaFormat>
							<version>${google-java-format.version}</version>
							<style>GOOGLE</style>
							<reflowLongStrings>true</reflowLongStrings>
							<formatJavadoc>true</formatJavadoc>
						</googleJavaFormat>
						<removeUnusedImports/>
						<formatAnnotations/>
					</java>
				</configuration>
				<executions>
					<execution>
						<id>spotless-check</id>
						<phase>validate</phase>
						<goals>
							<goal>check</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<!-- Conventions the formatter cannot fix: Google's bundled google_checks.xml, warnings treated as errors. -->
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-checkstyle-plugin</artifactId>
				<version>${maven-checkstyle-plugin.version}</version>
				<dependencies>
					<dependency>
						<groupId>com.puppycrawl.tools</groupId>
						<artifactId>checkstyle</artifactId>
						<version>${checkstyle.version}</version>
					</dependency>
				</dependencies>
				<configuration>
					<configLocation>google_checks.xml</configLocation>
					<includeTestSourceDirectory>true</includeTestSourceDirectory>
					<consoleOutput>true</consoleOutput>
					<failOnViolation>true</failOnViolation>
					<violationSeverity>warning</violationSeverity>
				</configuration>
				<executions>
					<execution>
						<id>checkstyle-check</id>
						<phase>validate</phase>
						<goals>
							<goal>check</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<!-- opentelemetry-proto is declared explicitly (runtime scope) but no BOM manages it.
				     Fail in validate when the declared version differs from the one micrometer-registry-otlp
				     depends on, so a Boot/Micrometer upgrade cannot silently keep an old pin. Dependabot
				     ignores the artifact (.github/dependabot.yml); bump it in the upgrade that fails here.
				     The same rule covers the OpenTelemetry instrumentation artifacts (logback appender,
				     kafka-clients), which share one version property and must resolve to one release.
				     Micrometer 1.18 (Boot 4.2) shades the proto and the rule then passes vacuously: see #127. -->
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-enforcer-plugin</artifactId>
				<executions>
					<execution>
						<id>opentelemetry-proto-convergence</id>
						<phase>validate</phase>
						<goals>
							<goal>enforce</goal>
						</goals>
						<configuration>
							<rules>
								<dependencyConvergence>
									<includes>
										<include>io.opentelemetry.proto:opentelemetry-proto</include>
										<include>io.opentelemetry.instrumentation:*</include>
									</includes>
								</dependencyConvergence>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
			<plugin>
				<!-- Mutation testing of the pure-logic route and decode packages. Not bound to a phase:
				     run ./mvnw test-compile org.pitest:pitest-maven:mutationCoverage (CI job "Mutation tests"). -->
				<groupId>org.pitest</groupId>
				<artifactId>pitest-maven</artifactId>
				<version>${pitest.version}</version>
				<dependencies>
					<dependency>
						<groupId>org.pitest</groupId>
						<artifactId>pitest-junit5-plugin</artifactId>
						<version>${pitest-junit5.version}</version>
					</dependency>
				</dependencies>
				<configuration>
					<targetClasses>
						<param>io.github.matabar.kafkafim.route.*</param>
						<param>io.github.matabar.kafkafim.decode.*</param>
					</targetClasses>
					<targetTests>
						<param>io.github.matabar.kafkafim.route.*Test</param>
						<param>io.github.matabar.kafkafim.decode.*Test</param>
					</targetTests>
					<excludedTestClasses>
						<param>**.*IntegrationTest</param>
					</excludedTestClasses>
					<mutationThreshold>${pitest.mutation.threshold}</mutationThreshold>
					<threads>2</threads>
					<outputFormats>
						<param>HTML</param>
						<param>XML</param>
					</outputFormats>
					<timestampedReports>false</timestampedReports>
				</configuration>
			</plugin>
			<plugin>
				<!-- Unit tests only; *IntegrationTest classes belong to Failsafe below -->
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<excludes>
						<exclude>**/*$*</exclude>
						<exclude>**/*IntegrationTest.java</exclude>
					</excludes>
				</configuration>
			</plugin>
			<plugin>
				<!-- Integration tests: *IntegrationTest classes (Testcontainers) run in integration-test/verify.
				     Google style forbids the conventional *IT suffix (AbbreviationAsWordInName). -->
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-failsafe-plugin</artifactId>
				<configuration>
					<!-- Each *IntegrationTest class runs in one of it.forkCount JVMs; containers are per class,
					     so forks share nothing but the Docker daemon. -->
					<forkCount>${it.forkCount}</forkCount>
					<reuseForks>true</reuseForks>
					<includes>
						<include>**/*IntegrationTest.java</include>
					</includes>
				</configuration>
				<executions>
					<execution>
						<goals>
							<goal>integration-test</goal>
							<goal>verify</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<!-- Unit (Surefire) and integration (Failsafe) tests write separate exec files; verify merges
				     them, writes the report to target/site/jacoco/ and enforces the floor on the merged data.
				     CI's two partial jobs pass -Djacoco.check.skip=true and the "Coverage" job checks the
				     merged data of both. -->
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>${jacoco.version}</version>
				<executions>
					<execution>
						<id>prepare-agent</id>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<execution>
						<id>prepare-agent-integration</id>
						<goals>
							<goal>prepare-agent-integration</goal>
						</goals>
					</execution>
					<execution>
						<id>merge</id>
						<phase>verify</phase>
						<goals>
							<goal>merge</goal>
						</goals>
						<configuration>
							<fileSets>
								<fileSet>
									<directory>${project.build.directory}</directory>
									<includes>
										<include>jacoco.exec</include>
										<include>jacoco-it.exec</include>
									</includes>
								</fileSet>
							</fileSets>
							<destFile>${project.build.directory}/jacoco-merged.exec</destFile>
						</configuration>
					</execution>
					<execution>
						<id>report</id>
						<phase>verify</phase>
						<goals>
							<goal>report</goal>
						</goals>
						<configuration>
							<dataFile>${project.build.directory}/jacoco-merged.exec</dataFile>
						</configuration>
					</execution>
					<execution>
						<id>check</id>
						<phase>verify</phase>
						<goals>
							<goal>check</goal>
						</goals>
						<configuration>
							<skip>${jacoco.check.skip}</skip>
							<dataFile>${project.build.directory}/jacoco-merged.exec</dataFile>
							<rules>
								<rule>
									<element>BUNDLE</element>
									<limits>
										<!-- Merged unit + integration coverage measured 2026-11-17: line 94.7 %,
										     branch 87.8 %. Floors sit just below; raise them when coverage rises. -->
										<limit>
											<counter>LINE</counter>
											<value>COVEREDRATIO</value>
											<minimum>0.94</minimum>
										</limit>
										<limit>
											<counter>BRANCH</counter>
											<value>COVEREDRATIO</value>
											<minimum>0.875</minimum>
										</limit>
									</limits>
								</rule>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<executions>
					<execution>
						<id>default-compile</id>
						<phase>compile</phase>
						<goals>
							<goal>compile</goal>
						</goals>
						<configuration>
							<annotationProcessorPaths>
								<path>
									<groupId>org.springframework.boot</groupId>
									<artifactId>spring-boot-configuration-processor</artifactId>
								</path>
							</annotationProcessorPaths>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
