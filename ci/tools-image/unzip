#!/usr/bin/env python3
"""Just enough of unzip(1) for the Maven wrapper: unzip [-q] ARCHIVE -d DIRECTORY.

The bundled job images have no unzip, and the wrapper falls back to a .tar.gz distribution that
the bundle does not carry. Keeps the file modes, which bin/mvn needs.
"""
import os
import sys
import zipfile


def main(argv):
    args = [a for a in argv if a != "-q"]
    if len(args) != 3 or args[1] != "-d":
        sys.exit("usage: unzip [-q] ARCHIVE -d DIRECTORY")
    archive, destination = args[0], args[2]
    with zipfile.ZipFile(archive) as z:
        for info in z.infolist():
            target = z.extract(info, destination)
            mode = info.external_attr >> 16
            if mode and not info.is_dir():
                os.chmod(target, mode & 0o777)


main(sys.argv[1:])
